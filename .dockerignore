.env1
.env.local
firebase-credentials.json
credentials.json
*.pem
*.key

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Sistema operacional
.DS_Store
Thumbs.db
Desktop.ini

